<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteAttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Attendance Record"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="ReadOnlyInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Attendance" Click="BackToAttendance_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Attendance" Click="EditAttendance_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Attendance" Click="AddAttendance_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" VerticalAlignment="Top" Height="100" BorderBrush="#e12749" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Select Date" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpAttendanceDate" Width="130" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Search Child ID" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildBox" Width="180" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="160" Height="35" 
                                  VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" 
                                  SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="90" Height="35" Margin="15,0,0,0" VerticalAlignment="Bottom" 
                            Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#EBE3F1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="50" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM ATTENDANCE RECORD DELETION" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="AttendanceListView" Grid.Row="0" SelectionMode="Single" SelectionChanged="AttendanceListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding AttendanceId}" Width="45"/>
                                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding AttendanceDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="90"/>
                                    <GridViewColumn Header="Center" DisplayMemberBinding="{Binding CenterName}" Width="130"/>
                                    <GridViewColumn Header="Child Name" DisplayMemberBinding="{Binding ChildName}" Width="160"/>
                                    <GridViewColumn Header="Status" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                                        <Setter Property="Fill" Value="LimeGreen"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                                        <Setter Property="Fill" Value="OrangeRed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                                        <Setter Property="Text" Value="Present"/>
                                                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                                        <Setter Property="Text" Value="Absent"/>
                                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Recorded By" DisplayMemberBinding="{Binding RecordedBy}" Width="110"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="1" Background="#FFEBEE" Padding="15" CornerRadius="5" BorderBrush="#FFCDD2" BorderThickness="1" Margin="0,15,0,0">
                            <TextBlock Text="⚠️ WARNING: Deletion is permanent. Ensure you have selected the correct record before proceeding." 
                                       Foreground="#B71C1C" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="DELETE SELECTED RECORD" 
                        Click="ConfirmDelete_Click" 
                        Width="220" Height="45"
                        Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>