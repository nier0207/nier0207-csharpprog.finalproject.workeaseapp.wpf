<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="WorkeaseAdmin_WPF.Pages.EditFeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Payment Record">

    <Page.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#4A148C"/>
        <SolidColorBrush x:Key="PrimaryPink" Color="#FF69B4"/>

        <Style x:Key="PinkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Fees" Click="BackToFees_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Payment" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Payment" Click="AddFee_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteFee_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child ID or Receipt No." Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchFeeBox" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="100" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,15">
                <ListView x:Name="FeesListView" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          Margin="5"
                          SelectionMode="Single"
                          SelectionChanged="FeesListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Receipt #" DisplayMemberBinding="{Binding FeeRecordReceiptNo}" Width="90"/>
                            <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding ChildName}" Width="140"/>
                            <GridViewColumn Header="Month" DisplayMemberBinding="{Binding FeeMonth}" Width="80"/>
                            <GridViewColumn Header="Year" DisplayMemberBinding="{Binding FeeYear}" Width="60"/>
                            <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding FeeMonthlyAmount, StringFormat=\{0:C\}}" Width="100"/>
                            <GridViewColumn Header="Status" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtStatus" Text="Unpaid" FontWeight="Bold"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                <Setter TargetName="txtStatus" Property="Text" Value="Paid"/>
                                                <Setter TargetName="txtStatus" Property="Foreground" Value="LimeGreen"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Due Date" DisplayMemberBinding="{Binding FeeDueDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Row="2" Background="#EBE3F1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="40" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT PAYMENT RECORD DETAILS" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="25,25">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Receipt Number" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBox x:Name="txtReceiptNo" IsReadOnly="True" Background="#F0F0F0" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#DDD"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Selected Child" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBox x:Name="txtChildName" IsReadOnly="True" Background="#F0F0F0" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#DDD"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Billing Month" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox x:Name="cmbFeeMonth" Height="30" VerticalContentAlignment="Center" BorderBrush="#DDD">
                                        <ComboBoxItem Content="January" Tag="1"/>
                                        <ComboBoxItem Content="February" Tag="2"/>
                                        <ComboBoxItem Content="March" Tag="3"/>
                                        <ComboBoxItem Content="April" Tag="4"/>
                                        <ComboBoxItem Content="May" Tag="5"/>
                                        <ComboBoxItem Content="June" Tag="6"/>
                                        <ComboBoxItem Content="July" Tag="7"/>
                                        <ComboBoxItem Content="August" Tag="8"/>
                                        <ComboBoxItem Content="September" Tag="9"/>
                                        <ComboBoxItem Content="October" Tag="10"/>
                                        <ComboBoxItem Content="November" Tag="11"/>
                                        <ComboBoxItem Content="December" Tag="12"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Billing Year" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox x:Name="cmbFeeYear" Height="30" VerticalContentAlignment="Center" BorderBrush="#DDD">
                                        <ComboBoxItem Content="2026"/>
                                        <ComboBoxItem Content="2027"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Amount (PHP)" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                <TextBox x:Name="txtFeeAmount" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="White" BorderThickness="1" BorderBrush="#DDD"/>
                            </StackPanel>

                            <Button Content="UPDATE PAYMENT" Click="UpdatePayment_Click" Width="180" Height="40" Margin="0,20,0,0" 
                                    Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>