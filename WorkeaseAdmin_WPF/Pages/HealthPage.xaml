<Page x:Class="WorkeaseAdmin_WPF.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Health Management">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Click="EditHealth_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteHealth_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar Section (Edit Center Style) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#FF69B4" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child Name or ID" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchHealthBox" Width="250" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search" Width="120" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Health Data Table -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#FF69B4" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60">
                        <TextBlock Text="CHILDREN'S HEALTH RECORDS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid>
                        <DataGrid x:Name="HealthDataGrid" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                  RowHeight="40" AlternatingRowBackground="#FAF5FF">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3E5F5"/>
                                    <Setter Property="Foreground" Value="#7E57C2"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#DDD"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Child ID" Binding="{Binding ChildID}" Width="80"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding Weight}" Width="100"/>
                                <DataGridTextColumn Header="Height (cm)" Binding="{Binding Height}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                                <DataGridTextColumn Header="Last Check-up" Binding="{Binding LastCheckup}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Placeholder Text -->
                        <TextBlock x:Name="EmptyMessage" Text="/* Search child to display health data */" 
                                   Foreground="#BDC3C7" FontSize="14" FontStyle="Italic" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>