<Window x:Class="WorkeaseAdmin_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workease Admin" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Section -->
        <Border Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Logo Area with Gradient -->
                <Border Grid.Row="0" Background="{StaticResource MainGradient}">
                    <TextBlock Text="Workease" 
               Foreground="White" 
               FontSize="24" 
               FontWeight="Bold" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <Button Content="Dashboard" Style="{StaticResource SidebarButtonStyle}" Tag="Dashboard" Click="Menu_Click"/>
                    <Button Content="Centers" Style="{StaticResource SidebarButtonStyle}" Tag="Centers" Click="Menu_Click"/>
                    <Button Content="Workers" Style="{StaticResource SidebarButtonStyle}" Tag="Workers" Click="Menu_Click"/>
                    <Button Content="Children" Style="{StaticResource SidebarButtonStyle}" Tag="Children" Click="Menu_Click"/>
                    <Button Content="Attendance" Style="{StaticResource SidebarButtonStyle}" Tag="Attendance" Click="Menu_Click"/>
                    <Button Content="Health" Style="{StaticResource SidebarButtonStyle}" Tag="Health" Click="Menu_Click"/>
                    <Button Content="Fees" Style="{StaticResource SidebarButtonStyle}" Tag="Fees" Click="Menu_Click"/>
                    <Button Content="Reports" Style="{StaticResource SidebarButtonStyle}" Tag="Reports" Click="Menu_Click"/>
                </StackPanel>

                <Button Grid.Row="2" 
                        Background="#E91E63" 
                        Margin="10" 
                        BorderThickness="0" 
                        Height="45" 
                        Cursor="Hand"
                        Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Logout" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="0,0,0,2">
                <DockPanel Margin="30,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtUserName"
                                       Text="Username" 
                                       FontWeight="Bold" 
                                       FontSize="16"
                                       HorizontalAlignment="Right"/>

                            <TextBlock x:Name="txtUserEmail"
                                       Text="example@workease.com" 
                                       FontSize="11" 
                                       Foreground="#666666" 
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0"/>

                            <TextBlock x:Name="txtUserType"
                                       Text="usertype" 
                                       FontSize="11" 
                                       Foreground="Gray" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Grid VerticalAlignment="Center">
                            <Ellipse Width="55" Height="55" Fill="{StaticResource PrimaryPink}"/>
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="White" 
                                  Stretch="Uniform" 
                                  Width="25" 
                                  Height="25" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="PageTitle" 
                               Text="Dashboard" 
                               VerticalAlignment="Center" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryPink}"/>
                </DockPanel>
            </Border>

            <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>