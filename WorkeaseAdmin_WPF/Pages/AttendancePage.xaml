<Page x:Class="WorkeaseAdmin_WPF.Pages.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Attendance">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Daily Logs" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Reports" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <ComboBox Width="150" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="- Select Center -"/>
                </ComboBox>
                <DatePicker Width="150" Height="35" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F3E5F5" BorderBrush="#FF5CA8" BorderThickness="1">
                <Grid>
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryPink}" Height="60">
                            <TextBlock Text="Attendance Monitoring" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <DataGrid AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Child ID" Width="80"/>
                                <DataGridTextColumn Header="Name" Width="*"/>
                                <DataGridTextColumn Header="Center" Width="*"/>
                                <DataGridTextColumn Header="Time In" Width="100"/>
                                <DataGridTextColumn Header="Status" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <TextBlock Text="/* Attendance records will show here */" Foreground="#85E15F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Export PDF" Width="150" Height="45" Background="{StaticResource CardBlue}" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button Content="Print" Width="120" Height="45" Background="#85E15F" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>