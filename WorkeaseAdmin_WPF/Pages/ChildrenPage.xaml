<Page x:Class="WorkeaseAdmin_WPF.Pages.ChildrenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Children">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Children" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Child" Click="EditChild_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Child" Click="AddChild_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Child" Click="DeleteChild_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <DockPanel Margin="20">
                <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                    <Grid>
                        <ComboBox HorizontalAlignment="Left" VerticalAlignment="Center" 
                                  Width="200" Height="35" Margin="15,0,0,0"
                                  Background="#B388FF" Foreground="Gray" BorderThickness="0"
                                  VerticalContentAlignment="Center" Padding="10,0">
                            <ComboBoxItem Content="San Pascual" IsSelected="True"/>
                            <ComboBoxItem Content="Other Center..."/>
                        </ComboBox>

                        <TextBlock Text="Children" Foreground="White" FontSize="22" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="0,0,10,10" Padding="10">
                    <StackPanel>
                        <DataGrid x:Name="ChildrenDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  Background="Transparent" BorderThickness="0" RowBackground="#FDFBFF" AlternatingRowBackground="#F3E5F5"
                                  FontSize="12" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="children_id" Binding="{Binding ID}" Width="80"/>
                                <DataGridTextColumn Header="first_name" Binding="{Binding FirstName}" Width="*"/>
                                <DataGridTextColumn Header="last_name" Binding="{Binding LastName}" Width="*"/>
                                <DataGridTextColumn Header="children_email" Binding="{Binding Email}" Width="1.5*"/>
                                <DataGridTextColumn Header="children_password" Binding="{Binding Password}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="Foreground" Value="#85E15F"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="children_guardian" Binding="{Binding Guardian}" Width="*"/>
                                <DataGridTextColumn Header="guardian_con..." Binding="{Binding Contact}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="/* Children Table: id, name, email, password (hashed), guardian details, etc." 
                                   Foreground="#85E15F" FontSize="12" Margin="10,20,0,0" FontWeight="SemiBold"/>

                        <TextBlock Text="/* Display more centers" 
                                   Foreground="#85E15F" HorizontalAlignment="Center" Margin="0,50,0,0" FontSize="14"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Page>