<Page x:Class="WorkeaseAdmin_WPF.Pages.ChildrenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Children"
      Loaded="Page_Loaded">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Children" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Child" Click="EditChild_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Child" Click="AddChild_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Child" Click="DeleteChild_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Border Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="MANAGE CHILDREN" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListView x:Name="ChildrenListView" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              Margin="10"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ChildId}" Width="40"/>

                                <GridViewColumn Header="Full Name" 
                                                DisplayMemberBinding="{Binding ChildFullName, TargetNullValue='N/A'}" 
                                                Width="150"/>

                                <GridViewColumn Header="Address" 
                                                DisplayMemberBinding="{Binding ChildAddress, TargetNullValue='N/A'}" 
                                                Width="180"/>

                                <GridViewColumn Header="Gender" 
                                                DisplayMemberBinding="{Binding ChildGender, TargetNullValue='N/A'}" 
                                                Width="60"/>

                                <GridViewColumn Header="Birth Date" 
                                                DisplayMemberBinding="{Binding ChildBirthDate, StringFormat=\{0:MM/dd/yyyy\}}" 
                                                Width="85"/>

                                <GridViewColumn Header="Assigned Center" 
                                                DisplayMemberBinding="{Binding CenterName, TargetNullValue='Unassigned'}" 
                                                Width="120"/>

                                <GridViewColumn Header="Enrolled Date" 
                                                DisplayMemberBinding="{Binding ChildEnrolledDate, StringFormat=\{0:MM/dd/yyyy\}}" 
                                                Width="90"/>

                                <GridViewColumn Header="Last Updated" 
                                                DisplayMemberBinding="{Binding ChildUpdatedDate, StringFormat=\{0:MM/dd/yyyy HH:mm\}, TargetNullValue='Never'}" 
                                                Width="115"/>

                                <GridViewColumn Header="Status" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="txtStatus" 
                                                       Text="INACTIVE" 
                                                       Foreground="Red" 
                                                       FontWeight="Bold"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ChildIsActive}" Value="True">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="ACTIVE"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="Lime"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>