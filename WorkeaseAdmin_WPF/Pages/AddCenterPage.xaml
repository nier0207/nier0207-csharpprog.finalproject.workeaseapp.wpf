<Page x:Class="WorkeaseAdmin_WPF.Pages.AddCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Center">

    <Page.Resources>
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Center" Click="EditCenter_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Center" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">

            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,49">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="NEW CENTER REGISTRATION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,40">

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Select Barangay (Location)" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                            <ComboBox x:Name="cmbBarangay" Style="{StaticResource InputControlStyle}" Padding="5,0">
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="Center Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                            <TextBox x:Name="txtCenterName" Style="{StaticResource InputControlStyle}"/>
                        </StackPanel>

                        <Border Background="#D1C4E9" Padding="20" CornerRadius="5">
                            <TextBlock Text="ℹ️ Note: Ensure the center name is unique. Once registered, you can assign Child Development Workers (CDW) and children in their respective management pages." 
                                       Foreground="#4527A0" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="Create New Center" Click="btnCreateCenter_Click" Width="200" Height="45"
                        Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>