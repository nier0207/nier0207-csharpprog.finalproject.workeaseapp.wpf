<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteFeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Payment Record">

    <Page.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#4A148C"/>

        <Style x:Key="ReadOnlyInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Fees" Click="BackToFees_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Payment" Click="EditFee_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Payment" Click="AddFee_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#e12749" BorderThickness="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child ID or Receipt No." Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchFeeBox" Width="250" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search Records" Click="Search_Click" Width="130" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,115,0,60">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM PAYMENT RECORD DELETION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="FeeListView" Grid.Row="0" SelectionMode="Single" SelectionChanged="FeeListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Receipt No." DisplayMemberBinding="{Binding FeeRecordReceiptNo}" Width="100"/>
                                    <GridViewColumn Header="Child Name" DisplayMemberBinding="{Binding ChildName}" Width="150"/>
                                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding FeeMonthlyAmount, StringFormat='PHP {0:N2}'}" Width="100"/>
                                    <GridViewColumn Header="Period" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding FeeMonth}"/>/<Run Text="{Binding FeeYear}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Status" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtStatus" 
                                                           Text="Unpaid" 
                                                           Foreground="OrangeRed" 
                                                           FontWeight="Bold"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                        <Setter TargetName="txtStatus" Property="Text" Value="Paid"/>
                                                        <Setter TargetName="txtStatus" Property="Foreground" Value="LimeGreen"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Recorded By" DisplayMemberBinding="{Binding UserName}" Width="110"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="1" Background="#FFEBEE" Padding="15" CornerRadius="5" BorderBrush="#FFCDD2" BorderThickness="1" Margin="0,15,0,0">
                            <TextBlock Text="⚠️ WARNING: Deletion is permanent. Select a row above to enable the Delete button." 
                                       Foreground="#B71C1C" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Button Content="DELETE SELECTED RECORD" 
                    Click="ConfirmDelete_Click" 
                    Width="220" Height="45"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>