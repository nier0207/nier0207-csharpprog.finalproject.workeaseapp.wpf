<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Health Record">

    <Page.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#4A148C"/>

        <Style x:Key="ReadOnlyInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Click="BackToHealth_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Click="EditHealth_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#e12749" BorderThickness="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child ID / Name" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchHealthBox" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search Records" Click="Search_Click" Width="130" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,115,0,60">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM HEALTH RECORD DELETION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="HealthListView" Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                                  SelectionMode="Single" SelectionChanged="HealthListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding HealthRecordId}" Width="45"/>
                                    <GridViewColumn Header="Child Name" DisplayMemberBinding="{Binding ChildName}" Width="140"/>
                                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding HealthRecordCreatedAt, StringFormat=\{0:MM/dd/yyyy\}}" Width="85"/>

                                    <GridViewColumn Header="Weight" DisplayMemberBinding="{Binding HealthWeightKg, StringFormat=\{0:F2\}}" Width="60"/>
                                    <GridViewColumn Header="Height" DisplayMemberBinding="{Binding HealthHeightCm, StringFormat=\{0:F1\}}" Width="60"/>

                                    <GridViewColumn Header="BMI Status" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtBmi" Text="{Binding BmiStatus}" FontWeight="Bold"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding BmiStatus}" Value="Normal">
                                                        <Setter TargetName="txtBmi" Property="Foreground" Value="LimeGreen"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BmiStatus}" Value="Underweight">
                                                        <Setter TargetName="txtBmi" Property="Foreground" Value="OrangeRed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BmiStatus}" Value="Overweight">
                                                        <Setter TargetName="txtBmi" Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Recorded By" DisplayMemberBinding="{Binding RecordedUserName}" Width="110"/>
                                    <GridViewColumn Header="Notes" DisplayMemberBinding="{Binding HealthNotes, TargetNullValue='---'}" Width="140"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="1" Background="#FFEBEE" Padding="15" CornerRadius="5" BorderBrush="#FFCDD2" BorderThickness="1" Margin="0,15,0,0">
                            <TextBlock Text="⚠️ WARNING: Deletion is permanent. Select a row above to enable the Delete button." 
                                       Foreground="#B71C1C" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Button Content="DELETE SELECTED RECORD" 
                    Click="ConfirmDelete_Click" 
                    Width="220" Height="45"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>