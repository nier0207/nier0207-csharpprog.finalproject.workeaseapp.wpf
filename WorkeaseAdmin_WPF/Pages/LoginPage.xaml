<Page x:Class="WorkeaseAdmin_WPF.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login" Height="720" Width="1280"
      Background="#F5F0FF">

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="40" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#7E57C2" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="WORK-EASE ADMIN" FontSize="26" FontWeight="Bold" Foreground="#7E57C2" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                <!-- DAPAT MAY x:Name ITO -->
                <TextBox x:Name="txtUsername" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                <!-- DAPAT MAY x:Name ITO -->
                <PasswordBox x:Name="txtPassword" Height="40" Margin="0,0,0,25" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>

                <!-- DAPAT SAKTO ANG Click NAME DITO -->
                <Button Content="LOGIN" Click="Login_Click" Background="#7E57C2" Foreground="White" Height="45" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>