<Page x:Class="WorkeaseAdmin_WPF.Pages.WorkersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Workers">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage CDW Workers" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1">
                <Grid>
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryPink}" Height="60">
                            <TextBlock Text="Workers" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <DataGrid AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="worker_id" Width="80"/>
                                <DataGridTextColumn Header="first_name" Width="*"/>
                                <DataGridTextColumn Header="last_name" Width="*"/>
                                <DataGridTextColumn Header="email" Width="*"/>
                                <DataGridTextColumn Header="assigned_center" Width="*"/>
                                <DataGridTextColumn Header="contact_no" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <TextBlock Text="/* Display more workers */" Foreground="#85E15F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Add Worker" Width="150" Height="45" Background="{StaticResource CardBlue}" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button Content="Delete Worker" Width="150" Height="45" Background="#FF5C5C" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>