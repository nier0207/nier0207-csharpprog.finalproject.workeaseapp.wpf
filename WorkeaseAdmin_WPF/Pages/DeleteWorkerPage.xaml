<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Worker">

    <Page.Resources>
        <!-- Matching ReadOnly Style from DeleteCenterPage -->
        <Style x:Key="ReadOnlyInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Worker" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">

            <!-- Search Bar Section: Exact Position and Color -->
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#e12749" BorderThickness="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Enter Worker ID to Delete" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchWorkerID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search Worker" Click="SearchWorker_Click" Width="150" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Confirmation Section: Exact Position and Color -->
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,115,0,49">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM WORKER DELETION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,40">
                        <!-- Worker Name Display -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Worker Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14" Foreground="#B00020"/>
                            <TextBox x:Name="txtWorkerName" Style="{StaticResource ReadOnlyInputStyle}"/>
                        </StackPanel>

                        <!-- Worker Role Display -->
                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="Worker Type" FontWeight="Bold" Margin="0,0,0,5" FontSize="14" Foreground="#B00020"/>
                            <TextBox x:Name="txtRole" Style="{StaticResource ReadOnlyInputStyle}"/>
                        </StackPanel>

                        <!-- Warning Message Box -->
                        <Border Background="#FFEBEE" Padding="20" CornerRadius="5" BorderBrush="#FFCDD2" BorderThickness="1">
                            <TextBlock Text="⚠️ WARNING: Deleting this worker will remove their access to the system and all associated records. This action is irreversible. Please verify the details above before clicking Delete." 
                                       Foreground="#B71C1C" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Delete Button Section -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="DELETE WORKER" Click="ConfirmDelete_Click" Width="200" Height="45"
                        Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>