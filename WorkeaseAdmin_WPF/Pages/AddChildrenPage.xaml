<Page x:Class="WorkeaseAdmin_WPF.Pages.AddChildrenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Children">

    <Grid Margin="30">
        <Border Background="#F3E5F5" CornerRadius="10" Padding="30">
            <StackPanel>
                <Border Background="{StaticResource PrimaryPink}" Margin="-30,-30,-30,20" CornerRadius="10,10,0,0" Height="50">
                    <TextBlock Text="Add Children" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10">
                        <TextBlock Text="First name" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                        <TextBlock Text="Last name" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10">
                        <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                        <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5"/>
                        <PasswordBox Height="35"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10">
                        <TextBlock Text="Address" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10" VerticalAlignment="Center">
                        <TextBlock Text="/* Add check box for gender (male or female)" Foreground="#85E15F" FontSize="11" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Male" Margin="0,0,20,0"/>
                            <CheckBox Content="Female"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="10">
                        <TextBlock Text="Gaurdian" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="10">
                        <TextBlock Text="Guardian contact no." FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="/* Ikaw nalang mag ayos ng positions nila pre HAHAHA," 
                           Foreground="#85E15F" HorizontalAlignment="Center" Margin="0,30,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="tignan mo lang pagkakasunod sunod na asa sinulat ko na table" 
                           Foreground="#85E15F" HorizontalAlignment="Center" TextAlignment="Center"/>

                <Button Content="Create New Worker" Width="180" Height="40" HorizontalAlignment="Right" Margin="0,30,0,0"
                        Background="{StaticResource CardBlue}" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>