<Page x:Class="WorkeaseAdmin_WPF.Pages.ChildrenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Children Registry">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Children" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Child" Click="EditChild_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Child" Click="AddChildren_Click" Background="#2ECC71" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Child" Click="DeleteChild_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Border Background="White" CornerRadius="10" BorderBrush="#27AE60" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#27AE60" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="CHILDREN REGISTRY" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="ChildrenGrid" AutoGenerateColumns="True" Margin="10" Background="Transparent" BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>