<Page x:Class="WorkeaseAdmin_WPF.Pages.EditHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Health Record">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Click="BackToHealth_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteHealth_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Edit Form Panel (Pink Themed) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" VerticalAlignment="Top" BorderBrush="#FF69B4" BorderThickness="1">
                <DockPanel>
                    <!-- Header turned Pink -->
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT HEALTH RECORD" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,25">
                        <!-- Child Selection (ReadOnly) -->
                        <TextBlock Text="Child Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FF69B4"/>
                        <TextBox x:Name="ChildNameDisplay" Height="35" BorderThickness="1" BorderBrush="#F3E5F5" IsReadOnly="True" Background="#FAF5FF" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                        <Grid Margin="0,10,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Weight -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight (kg)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <TextBox x:Name="WeightBox" Height="35" BorderThickness="1" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </StackPanel>

                            <!-- Height -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (cm)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <TextBox x:Name="HeightBox" Height="35" BorderThickness="1" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <!-- Nutritional Status -->
                        <TextBlock Text="Nutritional Status" FontWeight="Bold" Margin="0,10,0,5" Foreground="#444"/>
                        <ComboBox x:Name="StatusCombo" Height="35" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#DDD">
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Underweight"/>
                            <ComboBoxItem Content="Severely Underweight"/>
                            <ComboBoxItem Content="Overweight"/>
                            <ComboBoxItem Content="Obese"/>
                        </ComboBox>

                        <!-- Remarks -->
                        <TextBlock Text="Health Remarks" FontWeight="Bold" Margin="0,20,0,5" Foreground="#444"/>
                        <TextBox x:Name="RemarksBox" Height="80" BorderThickness="1" BorderBrush="#DDD" TextWrapping="Wrap" AcceptsReturn="True" Padding="10"/>

                        <TextBlock Text="/* Please double check weight and height values */" 
                                   Foreground="#FF69B4" FontSize="12" Margin="0,20,0,0" HorizontalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Save/Cancel Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Discard" Click="BackToHealth_Click" Width="120" Height="40" Background="Transparent" Foreground="Gray" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="SAVE CHANGES" Click="UpdateRecord_Click" Width="180" Height="40" Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>