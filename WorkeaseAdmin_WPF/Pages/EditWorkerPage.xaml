<Page x:Class="WorkeaseAdmin_WPF.Pages.EditWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="25">
            <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="{StaticResource PrimaryPink}" Height="55" CornerRadius="9,9,0,0">
                        <TextBlock Text="EDIT WORKER DETAILS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="30">
                        <TextBlock Text="Search ID First" FontSize="11" Foreground="Gray"/>
                        <TextBox Height="35" Margin="0,0,0,20"/>
                        <Button Content="Save Updates" Width="150" Height="45" Background="{StaticResource CardBlue}" Foreground="White" HorizontalAlignment="Right" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>