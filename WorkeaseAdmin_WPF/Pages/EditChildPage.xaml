<Page x:Class="WorkeaseAdmin_WPF.Pages.EditChildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Child">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Children" Click="ManageChildren_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Child" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Child" Click="AddChild_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Child" Click="DeleteChild_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30,30,30,10">
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" BorderBrush="#FF69B4" BorderThickness="1" Height="90">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Enter Child ID to Edit" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildID" Width="250" Height="26" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>
                    <Button Content="Search Child" Click="SearchChild_Click" Width="150" Height="29" Margin="20,18,0,0" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,95,0,80">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT CHILD DETAILS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,25">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="38" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="38" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="/* Review and update the child's information accurately." 
                                   Foreground="#85E15F" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,5">
               
                <Button Content="Save Changes" Width="180" Height="45" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>