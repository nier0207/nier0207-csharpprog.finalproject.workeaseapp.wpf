<Page x:Class="WorkeaseAdmin_WPF.Pages.EditFeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Payment Record">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Same Sub-nav) -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Fees" Click="BackToFees_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Payment" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Payment" Click="AddFee_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteFee_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Edit Form Panel (Pink Theme) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" VerticalAlignment="Top" BorderBrush="#FF69B4" BorderThickness="1.5">
                <DockPanel>
                    <!-- Header turned Pink -->
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT PAYMENT RECORD" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,25">
                        <!-- Child Name (ReadOnly for Edit) -->
                        <TextBlock Text="Child Full Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FF69B4"/>
                        <TextBox x:Name="txtChildName" Height="35" IsReadOnly="True" Background="#FAF5FF" BorderThickness="1" BorderBrush="#F3E5F5" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                        <Grid Margin="0,10,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amount Paid -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Amount (PHP)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <TextBox x:Name="AmountBox" Height="35" BorderThickness="1" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>

                            <!-- Date of Payment -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date of Payment" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <DatePicker x:Name="PaymentDatePicker" Height="35" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#DDD"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fee Type -->
                        <TextBlock Text="Fee Category" FontWeight="Bold" Margin="0,10,0,5" Foreground="#444"/>
                        <ComboBox x:Name="FeeTypeCombo" Height="35" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#DDD">
                            <ComboBoxItem Content="Tuition Fee"/>
                            <ComboBoxItem Content="Miscellaneous Fee"/>
                            <ComboBoxItem Content="Feeding Program"/>
                            <ComboBoxItem Content="Uniform/Books"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <!-- Remarks/Receipt No. -->
                        <TextBlock Text="Receipt No. / Remarks" FontWeight="Bold" Margin="0,20,0,5" Foreground="#444"/>
                        <TextBox x:Name="RemarksBox" Height="60" BorderThickness="1" BorderBrush="#DDD" TextWrapping="Wrap" AcceptsReturn="True" Padding="10"/>

                        <TextBlock Text="/* Review changes carefully before saving */" 
                                   Foreground="#FF69B4" FontSize="12" Margin="0,20,0,0" HorizontalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
               
                <Button Content="UPDATE PAYMENT" Click="UpdatePayment_Click" Width="200" Height="40" Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="1"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>