<Page x:Class="WorkeaseAdmin_WPF.Pages.AddChildrenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Child">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <StackPanel Grid.Column="0" Background="#1A0B2E">
            <Button Content="Manage Children" Click="ManageChildren_Click" Background="#1A0B2E" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Child" Click="EditChild_Click" Background="#1A0B2E" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Child" Background="#2ECC71" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Child" Click="DeleteChild_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="#EBE3F1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="Add Child" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,20">
                        <!-- Name Row -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Guardian Name" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox Height="35" BorderThickness="0" Margin="0,0,0,15"/>

                        <TextBlock Text="Birth Day" FontWeight="Bold" Margin="0,10,0,5"/>
                        <DatePicker Height="35"/>

                        <TextBlock Text="Gender" FontWeight="Bold" Margin="0,15,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Male" Margin="0,0,20,0"/>
                            <RadioButton Content="Female"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Content="Create New Record" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                    Width="180" Height="45" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        </Grid>
    </Grid>
</Page>