<Page x:Class="WorkeaseAdmin_WPF.Pages.EditCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Center">

    <Page.Resources>
        <Style x:Key="PinkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF69B4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Center" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Center" Click="AddCenter_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <!-- Search Bar Section: Pantay na ang TextBox at Button -->
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#FF69B4" BorderThickness="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Enter Center ID to Edit" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchCenterID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <!-- Margin-top is 0 to align with TextBox -->
                    <Button Content="Search Center" Click="SearchCenter_Click" Width="150" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Edit Form Section -->
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,115,0,49">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT CENTER" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,20">
                        <!-- editable -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Center Name" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtCenterName" Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- editable -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Center Location" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCenterLocation" Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>

                            <!-- VIEW ONLY (Read Only) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CDW Center Holder (Read-Only)" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCdwName" Height="40" Background="#F0F0F0" Foreground="Gray" IsReadOnly="True" Focusable="False" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- VIEW ONLY -->
                        <StackPanel>
                            <TextBlock Text="Registered Children (Read-Only)" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Border Background="#F9F9F9" Height="150" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                                <ListBox x:Name="listChildren" BorderThickness="0" Background="Transparent" Foreground="Gray" Focusable="False" SelectionMode="Single"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bottom Buttons -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">

                <Button Content="Save Changes" Click="SaveChanges_Click" Width="160" Height="45"
                        Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>