<Page x:Class="WorkeaseAdmin_WPF.Pages.EditAttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Attendance Record"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="PinkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Attendance" Click="BackToAttendance_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Attendance" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Attendance" Click="AddAttendance_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteAttendance_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" VerticalAlignment="Top" Height="100" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Select Date" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpAttendanceDate" Width="130" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Search Child ID" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildBox" Width="180" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="160" Height="35" 
                                  VerticalContentAlignment="Center" 
                                  DisplayMemberPath="CenterName" 
                                  SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="90" Height="35" Margin="15,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,15">
                <ListView x:Name="AttendanceListView" Background="Transparent" BorderThickness="0" Margin="5" SelectionMode="Single" SelectionChanged="AttendanceListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding AttendanceId}" Width="45"/>
                            <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding ChildName}" Width="150"/>
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding AttendanceDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="90"/>
                            <GridViewColumn Header="Current" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                            <Setter Property="Text" Value="Present"/>
                                                            <Setter Property="Foreground" Value="LimeGreen"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                            <Setter Property="Text" Value="Absent"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Action" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="ToggleStatus_Click" Foreground="White" FontSize="9" FontWeight="Bold" Padding="5,2" Cursor="Hand" Width="95">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                            <Setter Property="Content" Value="MARK ABSENT"/>
                                                            <Setter Property="Background" Value="#e12749"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                            <Setter Property="Content" Value="MARK PRESENT"/>
                                                            <Setter Property="Background" Value="LimeGreen"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Row="2" Background="#EBE3F1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="40" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT ATTENDANCE RECORD DETAILS" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="25">
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Selected Child" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                <TextBox x:Name="txtChildName" IsReadOnly="True" Background="#F0F0F0" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Attendance Date" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <DatePicker x:Name="dpEditDate" Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Status" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox x:Name="cmbStatus" Height="30" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Present" Tag="True"/>
                                        <ComboBoxItem Content="Absent" Tag="False"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Background="#DCD0E8" Padding="15" CornerRadius="5" Margin="0,5,0,15">
                                <UniformGrid Columns="2">
                                    <StackPanel>
                                        <TextBlock Text="Created At" Foreground="#666" FontSize="11"/>
                                        <TextBlock x:Name="txtCreatedAt" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Last Updated" Foreground="#666" FontSize="11"/>
                                        <TextBlock x:Name="txtUpdatedAt" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <Button Content="UPDATE ATTENDANCE" Click="UpdateAttendance_Click" Width="180" Height="40" 
                                    Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>