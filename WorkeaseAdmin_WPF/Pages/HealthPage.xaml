<Page x:Class="WorkeaseAdmin_WPF.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Health Management"
      Loaded="Page_Loaded">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Matching WorkersPage Layout) -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Click="EditHealth_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteHealth_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search & Filter Bar Section -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Text Search -->
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child ID" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchHealthBox" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <!-- Center Name Filter -->
                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <!-- Search Action Button -->
                    <Button Content="Search Records" Click="Search_Click" Width="130" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Health Records Table (Styled like WorkersPage ListView) -->
            <Border Grid.Row="1" Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <!-- Header Bar -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="CHILDREN'S HEALTH RECORDS" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Main Data List -->
                    <ListView x:Name="HealthListView" 
          Background="Transparent" 
          BorderThickness="0" 
          Margin="10"
          SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <!-- Record ID -->
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding HealthRecordId}" Width="50"/>

                                <!-- Child Info -->
                                <GridViewColumn Header="Child ID" DisplayMemberBinding="{Binding ChildId}" Width="60"/>
                                <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding ChildName}" Width="160"/>

                                <!-- ADDED: Recorded At (The actual log date) -->
                                <GridViewColumn Header="Date Recorded" 
                            DisplayMemberBinding="{Binding HealthRecordCreatedAt, StringFormat=\{0:MM/dd/yyyy\}}" 
                            Width="100"/>

                                <!-- Measurements -->
                                <GridViewColumn Header="Weight (kg)" 
                            DisplayMemberBinding="{Binding HealthWeightKg, StringFormat=\{0:F2\}}" 
                            Width="80"/>
                                <GridViewColumn Header="Height (cm)" 
                            DisplayMemberBinding="{Binding HealthHeightCm, StringFormat=\{0:F1\}}" 
                            Width="80"/>
                                <GridViewColumn Header="BMI" 
                            DisplayMemberBinding="{Binding HealthBmi, StringFormat=\{0:F1\}}" 
                            Width="50"/>

                                <!-- BMI Status with Consistent Color Logic -->
                                <GridViewColumn Header="BMI Status" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="txtBmiStatus" 
                                   Text="{Binding BmiStatus}" 
                                   FontWeight="Bold"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding BmiStatus}" Value="Normal">
                                                    <Setter TargetName="txtBmiStatus" Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BmiStatus}" Value="Underweight">
                                                    <Setter TargetName="txtBmiStatus" Property="Foreground" Value="OrangeRed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BmiStatus}" Value="Overweight">
                                                    <Setter TargetName="txtBmiStatus" Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BmiStatus}" Value="Obese">
                                                    <Setter TargetName="txtBmiStatus" Property="Foreground" Value="DarkRed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Staff Info -->
                                <GridViewColumn Header="Recorded By" 
                            DisplayMemberBinding="{Binding RecordedUserName, TargetNullValue='System'}" 
                            Width="120"/>

                                <!-- Notes -->
                                <GridViewColumn Header="Notes" 
                            DisplayMemberBinding="{Binding HealthNotes, TargetNullValue='---'}" 
                            Width="140"/>

                                <!-- ADDED: Last Updated (New Property) -->
                                <GridViewColumn Header="Last Edit" 
                            DisplayMemberBinding="{Binding HealthRecordUpdatedAt, StringFormat=\{0:MM/dd/yyyy HH:mm\}}" 
                            Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>