<Page x:Class="WorkeaseAdmin_WPF.Pages.AddWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Worker" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,48">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0" Margin="0,0,0,20">
                        <TextBlock Text="Add Worker" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="30,10">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5"/>
                                <PasswordBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Address" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Birth day" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DatePicker Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contact no." FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Height="35" Background="White" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gender" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton Content="Male" Margin="0,0,20,0"/>
                                    <RadioButton Content="Female"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Fill out the employee information accurately to ensure proper management within the WorkEase system." 
                                   Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Content="Create New Worker" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Width="180" Height="45" Margin="0,0,0,-15"
                    Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>