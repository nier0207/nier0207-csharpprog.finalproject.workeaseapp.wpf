<Page x:Class="WorkeaseAdmin_WPF.Pages.AddAttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Attendance Record">

    <Page.Resources>
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Attendance" Click="BackToAttendance_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Attendance" Click="EditAttendance_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Attendance" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteAttendance_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#38b6ff" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Enter Child ID to Record Attendance" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search Child" Click="SearchChild_Click" Width="150" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,49">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="NEW ATTENDANCE RECORD REGISTRATION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30">

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Child Full Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                <TextBox x:Name="txtChildName" Style="{StaticResource InputControlStyle}" 
                             IsReadOnly="True" Background="#F0F0F0" Foreground="#555"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Attendance Date" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <DatePicker x:Name="dpDate" Style="{StaticResource InputControlStyle}" Padding="5,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Attendance Status" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <ComboBox x:Name="cmbStatus" Style="{StaticResource InputControlStyle}">
                                        <ComboBoxItem Content="Present" Tag="True" IsSelected="True"/>
                                        <ComboBoxItem Content="Absent" Tag="False"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Background="#D1C4E9" Padding="20" CornerRadius="5">
                                <TextBlock Text="ℹ️ Note: Please ensure the correct child is selected and the date is accurate. This record will be used for monthly reporting and evaluation." 
                               Foreground="#4527A0" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="Record Attendance" Click="CreateAttendance_Click" Width="200" Height="45"
                        Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>