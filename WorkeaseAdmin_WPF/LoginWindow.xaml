<Window x:Class="WorkeaseAdmin_WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workease Admin - Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Border CornerRadius="20" Margin="30" Background="White" MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#D1C4E9" ShadowDepth="2" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" Background="{StaticResource DeepPurple}" CornerRadius="20,0,0,20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="WorkEase" Foreground="White" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="ADMIN MANAGEMENT SYSTEM" Foreground="#D1C4E9" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <Border Background="{StaticResource PrimaryPink}" Height="4" Width="40" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Right Panel -->
            <Grid Grid.Column="1" Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Welcome Back!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                    <TextBlock Text="Authorized personnel only. Please sign in." Foreground="Gray" Margin="0,0,0,25" FontSize="13"/>

                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="txtUsername" Height="35" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Background="Transparent"/>
                    </Border>

                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,0,25">
                        <PasswordBox x:Name="txtPassword" Height="35" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Background="Transparent"/>
                    </Border>

                    <Button Content="LOGIN" Click="LoginButton_Click" Height="40" 
                            Background="{StaticResource PrimaryPink}" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Exit Application" Click="Exit_Click" Margin="0,15,0,0" Background="Transparent" Foreground="Gray" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>