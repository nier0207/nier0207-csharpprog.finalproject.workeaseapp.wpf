<Page x:Class="WorkeaseAdmin_WPF.Pages.AddWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Worker" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="White" CornerRadius="15" BorderBrush="#38b6ff" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#38b6ff" CornerRadius="14,14,0,0">
                        <TextBlock Text="REGISTER NEW WORKER" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,20">
                            <TextBlock Text="Full Name" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="Position / Role" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="Contact Number" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="Assign to Center" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <ComboBox Height="40" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

                            <Button Content="Register Worker" Width="200" Height="50" HorizontalAlignment="Right" 
                                    Background="#38b6ff" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>