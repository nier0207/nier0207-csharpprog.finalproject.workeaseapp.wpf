<Page x:Class="WorkeaseAdmin_WPF.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports Hub">

    <Grid Background="#F5F0FF">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="REPORTS MANAGEMENT" FontSize="26" FontWeight="Bold" 
                       Foreground="{StaticResource DeepPurple}" Margin="10,0,0,30"/>

            <!-- 2 Rows, 2 Columns Grid (Apat lang) -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="2">

                <!-- 1. MASTER LIST (Pink/Red Style) -->
                <Button Click="MasterList_Click" Margin="15" Background="#F0808C" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Master List" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="View Records" FontSize="14" Foreground="#444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. PDF GENERATE (Purple Style) -->
                <Button Click="PDFGenerate_Click" Margin="15" Background="#8B7DFF" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PDF Generate" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Export to Document" FontSize="14" Foreground="#333" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 3. REPORT FEE (Light Purple Style) -->
                <Button Click="ReportFee_Click" Margin="15" Background="#C480F0" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Report Fee" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Financial Summary" FontSize="14" Foreground="#333" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 4. LIST OF REPORTS (Blue Style) -->
                <Button Click="ListOfReports_Click" Margin="15" Background="#6495ED" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="List of Reports" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Archive History" FontSize="14" Foreground="#333" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </UniformGrid>
        </Grid>
    </Grid>
</Page>