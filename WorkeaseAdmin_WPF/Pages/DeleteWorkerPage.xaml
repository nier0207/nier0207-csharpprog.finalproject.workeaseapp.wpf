<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Worker" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="30">
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Enter Worker ID" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchWorkerID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>
                    <Button Content="Search Worker" Click="SearchWorker_Click" Width="150" Height="35" Margin="20,18,0,0" Background="#B00020" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="15" BorderBrush="#B00020" BorderThickness="1">
                <StackPanel>
                    <Border Background="#B00020" Height="50" CornerRadius="14,14,0,0">
                        <TextBlock Text="CONFIRM DELETION" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="30">
                        <TextBlock Text="Name of Worker" Foreground="#B00020" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox IsReadOnly="True" Height="40" Background="#F9F9F9" Margin="0,0,0,20"/>

                        <TextBlock Text="Position" Foreground="#B00020" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox IsReadOnly="True" Height="40" Background="#F9F9F9" Margin="0,0,0,20"/>

                        <Button Content="DELETE WORKER" Width="200" Height="45" HorizontalAlignment="Right" Background="#B00020" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>