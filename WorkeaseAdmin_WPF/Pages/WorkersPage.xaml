<Page x:Class="WorkeaseAdmin_WPF.Pages.WorkersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Workers"
      Loaded="Page_Loaded">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Border Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="MANAGE WORKERS" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListView x:Name="WorkersListView" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              Margin="10"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <!-- ID Column -->
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserId}" Width="50"/>

                                <!-- Name Column -->
                                <GridViewColumn Header="Full Name" 
                            DisplayMemberBinding="{Binding UserName, TargetNullValue='---', FallbackValue='---'}" 
                            Width="180"/>

                                <!-- Email Column -->
                                <GridViewColumn Header="Email Address" 
                            DisplayMemberBinding="{Binding UserEmail, TargetNullValue='---'}" 
                            Width="200"/>

                                <!-- User Type (Worker/Admin/etc) -->
                                <GridViewColumn Header="Type" 
                            DisplayMemberBinding="{Binding UserType, TargetNullValue='---'}" 
                            Width="100"/>

                                <!-- Center Name Column -->
                                <GridViewColumn Header="Assigned Center" 
                            DisplayMemberBinding="{Binding CenterName, TargetNullValue='Unassigned'}" 
                            Width="150"/>

                                <!-- Status Column with Dynamic Colors -->
                                <GridViewColumn Header="Status" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="txtStatus" 
                                   Text="INACTIVE" 
                                   Foreground="Red" 
                                   FontWeight="Bold"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding UserIsActive}" Value="True">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="ACTIVE"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Created Date -->
                                <GridViewColumn Header="Date Created" 
                            DisplayMemberBinding="{Binding UserCreatedAt, StringFormat=\{0:MM/dd/yyyy\}, TargetNullValue='---'}" 
                            Width="110"/>

                                <!-- Updated Date (The new property you added) -->
                                <GridViewColumn Header="Last Updated" 
                            DisplayMemberBinding="{Binding UserUpdatedAt, StringFormat=\{0:MM/dd/yyyy HH:mm\}, TargetNullValue='---'}" 
                            Width="140"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>