<Page x:Class="WorkeaseAdmin_WPF.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Loaded="Page_Loaded">

    <UniformGrid Columns="3" Rows="2" Margin="20">

        <!-- Number of Centers -->
        <Border Background="#F27E8C" CornerRadius="12" Margin="15">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                <TextBlock x:Name="txtCenterTotalNo"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Text="0"/>
                <TextBlock Text="Number of Centers" 
                           FontSize="16" 
                           FontWeight="Medium"
                           Foreground="#FFF0F2"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Number of Workers -->
        <Border Background="#8A61FF" CornerRadius="12" Margin="15">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                <TextBlock x:Name="txtUserTotalNo"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Text="0"/>
                <TextBlock Text="Number of Workers" 
                           FontSize="16" 
                           FontWeight="Medium"
                           Foreground="#F1ECFF"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Number of Children -->
        <Border Background="#C576EE" CornerRadius="12" Margin="15">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                <TextBlock x:Name="txtChildrenTotalNo"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Text="0"/>
                <TextBlock Text="Number of Children" 
                           FontSize="16" 
                           FontWeight="Medium"
                           Foreground="#FAF0FF"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Accumulated Abnormal Health -->
        <Border Background="#86E05E" CornerRadius="12" Margin="15">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                <TextBlock x:Name="txtAbnormalHealthTotalNo"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Text="0"/>
                <TextBlock Text="Accumulated Abnormal Health of Children" 
                           FontSize="16" 
                           FontWeight="Medium"
                           Foreground="#F2FFE9"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Total Accumulated Fees -->
        <Border Background="#5E8BFF" CornerRadius="12" Margin="15">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                <TextBlock x:Name="txtFeeTotalAccumulated"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Text="₱0.00"/>
                <TextBlock Text="Total Accumulated Fees" 
                           FontSize="16" 
                           FontWeight="Medium"
                           Foreground="#EEF3FF"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

    </UniformGrid>
</Page>