<Page x:Class="WorkeaseAdmin_WPF.Pages.AddWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage CDW Workers" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#F3E5F5" Margin="30" CornerRadius="5">
            <StackPanel>
                <Border Background="{StaticResource PrimaryPink}" Height="50">
                    <TextBlock Text="Add Worker" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <UniformGrid Columns="2" Margin="20">
                    <StackPanel Margin="10">
                        <TextBlock Text="First name" FontWeight="Bold"/>
                        <TextBox Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Last name" FontWeight="Bold"/>
                        <TextBox Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Email" FontWeight="Bold"/>
                        <TextBox Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Password" FontWeight="Bold"/>
                        <PasswordBox Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Address" FontWeight="Bold"/>
                        <TextBox Height="30" Margin="0,5,0,0"/>
                        <TextBlock Text="/* Add birth day container" Foreground="#85E15F" FontSize="12" Margin="0,40,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Contact no." FontWeight="Bold"/>
                        <TextBox Height="30" Margin="0,5,0,0"/>
                        <TextBlock Text="/* Add check box for gender (male or female)" Foreground="#85E15F" FontSize="12" Margin="0,40,0,0"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="/* Add a bit of description about this page" Foreground="#85E15F" HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <Button Content="Create New Worker" HorizontalAlignment="Right" Margin="0,20,20,0" Width="150" Height="40" Background="#4FC3F7" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>