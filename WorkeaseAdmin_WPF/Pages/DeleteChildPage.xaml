<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteChildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Child">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Children" Click="ManageChildren_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Child" Click="EditChild_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Child" Click="AddChild_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Child" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <!-- Search Section -->
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" BorderBrush="#e12749" BorderThickness="1" Height="90">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Enter Child ID to Delete" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildID" Width="250" Height="28" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>
                    <Button Content="Search Child" Click="SearchChild_Click" Width="150" Height="29" Margin="20,18,0,0" Background="#1A0B2E" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Information Display Section (Laman ng Bata) -->
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,95,0,80">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM DELETE RECORD" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,25">
                        <TextBlock Text="Child Details:" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1A0B2E"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtFirstName" IsReadOnly="True" Height="35" Background="#F0F0F0" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLastName" IsReadOnly="True" Height="35" Background="#F0F0F0" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Guardian Name" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtGuardian" IsReadOnly="True" Height="35" Background="#F0F0F0" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                        <TextBlock Text="/* Warning: Deleting this record is permanent." 
                                   Foreground="#e12749" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,5">
                <Button Content="Keep Record" Click="ManageChildren_Click" Width="130" Height="45" Margin="0,0,15,0" Background="#BDC3C7" Foreground="Black" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="Confirm Delete" Click="ConfirmDelete_Click" Width="180" Height="45" Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>