<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Worker">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Worker" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="25">
            <Border Background="White" CornerRadius="10" BorderBrush="#e12749" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="#e12749" Height="55" CornerRadius="9,9,0,0">
                        <TextBlock Text="CONFIRM DELETE WORKER" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="30">
                        <TextBlock Text="Are you sure you want to delete this worker?" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="DELETE" Width="150" Height="45" Background="#e12749" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>