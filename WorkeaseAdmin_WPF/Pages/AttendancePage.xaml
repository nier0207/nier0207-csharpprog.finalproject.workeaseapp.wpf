<Page x:Class="WorkeaseAdmin_WPF.Pages.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Attendance Monitoring"
      Loaded="Page_Loaded">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Attendance" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Attendance" Click="EditAttendance_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Attendance" Click="AddAttendance_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteAttendance_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Height="100" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Select Date" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpAttendanceDate" Width="140" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Search Child ID" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildBox" Width="180" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="160" Height="35" DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="90" Height="35" Margin="15,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="ATTENDANCE MONITORING" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListView x:Name="AttendanceListView" Background="Transparent" BorderThickness="0" Margin="10" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding AttendanceId}" Width="50"/>
                                <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding ChildName}" Width="160"/>

                                <GridViewColumn Header="Status" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="txtStatus" FontWeight="Bold"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="Present"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="Absent"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="#e12749"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Attendance Date" DisplayMemberBinding="{Binding AttendanceDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="110"/>
                                <GridViewColumn Header="Recorded By" DisplayMemberBinding="{Binding RecordedBy}" Width="120"/>

                                <GridViewColumn Header="Date Created" DisplayMemberBinding="{Binding CreatedAt, StringFormat=\{0:MM/dd/yyyy HH:mm\}}" Width="130"/>
                                <GridViewColumn Header="Last Updated" DisplayMemberBinding="{Binding UpdatedAt, StringFormat=\{0:MM/dd/yyyy HH:mm\}}" Width="130"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>