<Page x:Class="WorkeaseAdmin_WPF.Pages.AddWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Worker">

    <Page.Resources>
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Worker" Click="EditWorker_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Worker" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,49">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="NEW WORKER REGISTRATION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="First Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBox x:Name="txtFirstName" Style="{StaticResource InputControlStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBox x:Name="txtLastName" Style="{StaticResource InputControlStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email Address" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <Grid>
                                        <TextBox x:Name="txtEmail" Style="{StaticResource InputControlStyle}"/>
                                        <TextBlock Text="username@workease.burgos.ph" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtEmail}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <Grid>
                                        <PasswordBox x:Name="txtPassword" Style="{StaticResource InputControlStyle}" Padding="10,0,40,0"/>

                                        <TextBox x:Name="txtPasswordUnmasked" Style="{StaticResource InputControlStyle}" Padding="10,0,40,0" Visibility="Collapsed"/>

                                        <TextBlock Text="Min. 8 chars (A-z, 0-9, !@#)" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,40,0" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Password.Length, ElementName=txtPassword}" Value="0"/>
                                                                <Condition Binding="{Binding Text.Length, ElementName=txtPasswordUnmasked}" Value="0"/>
                                                                <Condition Binding="{Binding Visibility, ElementName=txtPassword}" Value="Visible"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Min. 8 chars (A-z, 0-9, !@#)" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,40,0" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Password.Length, ElementName=txtPassword}" Value="0"/>
                                                                <Condition Binding="{Binding Text.Length, ElementName=txtPasswordUnmasked}" Value="0"/>
                                                                <Condition Binding="{Binding Visibility, ElementName=txtPasswordUnmasked}" Value="Visible"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button x:Name="btnTogglePassword" HorizontalAlignment="Right" Width="35" Height="40" 
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnTogglePassword_Click">
                                            <Image x:Name="imgEye" Source="pack://application:,,,/Images/eye_visible.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Role Type" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <ComboBox x:Name="cmbRole" Style="{StaticResource InputControlStyle}" Padding="5,0">
                                        <ComboBoxItem Content="CDW"/>
                                        <ComboBoxItem Content="Admin"/>
                                        <ComboBoxItem Content="Parent"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Assign Center" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <ComboBox x:Name="cmbCenter" Style="{StaticResource InputControlStyle}" Padding="5,0"
                                              DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#D1C4E9" Padding="20" CornerRadius="5">
                                <TextBlock Text="ℹ️ Note: Fill out the employee information accurately. Once registered, the worker can access their account using the provided email and password." 
                                           Foreground="#4527A0" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="Create New Worker" Click="btnCreateWorker_Click" Width="200" Height="45"
                        Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>