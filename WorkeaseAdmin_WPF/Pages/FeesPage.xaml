<Page x:Class="WorkeaseAdmin_WPF.Pages.FeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Fees Management">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Consistent Sub-nav) -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Fees" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Payment" Click="EditFee_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Payment" Click="AddFee_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteFee_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar Section (Pink Accent) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#FF69B4" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child Name or Receipt No." Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchFeeBox" Width="250" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <Button Content="Search" Width="120" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Fees Data Table (Pink Theme) -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#FF69B4" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <!-- Header turned Pink -->
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60">
                        <TextBlock Text="FEES AND PAYMENT RECORDS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid>
                        <DataGrid x:Name="FeesDataGrid" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="45" CanUserAddRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FAF5FF"/>
                                    <Setter Property="Foreground" Value="#FF69B4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F3E5F5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" Width="120"/>
                                <DataGridTextColumn Header="Child Name" Binding="{Binding ChildName}" Width="*"/>
                                <DataGridTextColumn Header="Fee Type" Binding="{Binding FeeType}" Width="150"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="/* Results will be displayed here */" Foreground="#D1D1D1" FontSize="14" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>