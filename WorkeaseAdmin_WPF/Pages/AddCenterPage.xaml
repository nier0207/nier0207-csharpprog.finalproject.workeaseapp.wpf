<Page x:Class="WorkeaseAdmin_WPF.Pages.AddCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Center">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Center" Click="EditCenter_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Center" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,49">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0" Margin="0,0,0,30">
                        <TextBlock Text="Add Center" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,10">
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Barangay" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <ComboBox Height="40" Background="#ff66c4" Foreground="Gray" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0">
                                    <ComboBoxItem Content="- Select baranggay -" IsSelected="True" IsEnabled="False"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CDW worker" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <ComboBox Height="40" Background="#FF69B4" Foreground="Gray" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0">
                                    <ComboBoxItem Content="- Select CDW Worker -" IsSelected="True" IsEnabled="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Center name" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <TextBox Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact person" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <TextBox Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="*Provide the necessary details to register a new community center. Ensure all fields are accurate for efficient monitoring." 
                                   Foreground="black" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Content="Create New Center" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Width="180" Height="45" Margin="0,0,0,-15"
                    Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>