<Page x:Class="WorkeaseAdmin_WPF.Pages.EditCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Center">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Center" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Center" Click="AddCenter_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Search ID" FontSize="11" Foreground="Gray"/>
                        <TextBox Width="80" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Search Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Width="180" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Search Center" Width="120" Height="30" Margin="0,15,0,0" 
                            Background="{StaticResource CardBlue}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="55" CornerRadius="9,9,0,0">
                        <TextBlock Text="EDIT CENTER DETAILS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,20">
                            <TextBlock Text="Update Center Name" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="Update Barangay" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                            <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>


                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel Changes" Click="ManageCenters_Click" Width="140" Height="45" Background="#E0E0E0" Margin="0,0,10,0" BorderThickness="0"/>
                                <Button Content="Save Updates" Width="160" Height="45" Background="{StaticResource CardBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>