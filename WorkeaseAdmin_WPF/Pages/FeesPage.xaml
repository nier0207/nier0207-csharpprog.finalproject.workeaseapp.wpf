<Page x:Class="WorkeaseAdmin_WPF.Pages.FeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Fees Management"
      Loaded="Page_Loaded">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="View Fees" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Payment" Click="EditFee_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Payment" Click="AddFee_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteFee_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>

            <Separator Background="White" Opacity="0.2" Margin="10,20,10,10"/>

            <Button x:Name="btnGenerateMonthly" Content="Generate Monthly" Click="GenerateMonthlyFee_Click" Background="Lime" Foreground="White" Height="45" Margin="10,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="btnProcessOverdue" Content="Process Overdue" Click="ProcessOverdue_Click" Background="#FF8C00" Foreground="White" Height="45" Margin="10,8,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search & Filter Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Receipt No. or Child ID" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchFeeBox" Width="250" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="100" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Recoded Fees Records Table -->
            <Border Grid.Row="1" Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60" CornerRadius="9,9,0,0">
                        <TextBlock Text="FEES AND PAYMENT RECORDS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListView x:Name="FeesListView" Background="Transparent" BorderThickness="0" Margin="10" SelectionMode="Single" SelectionChanged="FeesListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Receipt No." DisplayMemberBinding="{Binding FeeRecordReceiptNo}" Width="90"/>
                                <GridViewColumn Header="Child Name" DisplayMemberBinding="{Binding ChildName}" Width="140"/>
                                <GridViewColumn Header="Due Date" DisplayMemberBinding="{Binding FeeDueDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="90"/>

                                <GridViewColumn Header="Amount" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FeeMonthlyAmount, StringFormat='₱{0:N2}'}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Status" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="txtStatus" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="PAID"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="UNPAID"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter TargetName="txtStatus" Property="Text" Value="OVERDUE"/>
                                                    <Setter TargetName="txtStatus" Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Paid Date" DisplayMemberBinding="{Binding FeePaidDate, StringFormat=\{0:MM/dd/yyyy\}, TargetNullValue='---'}" Width="90"/>
                                <GridViewColumn Header="Recorded By" DisplayMemberBinding="{Binding UserName}" Width="100"/>

                                <GridViewColumn Header="Action" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btnMarkPaid" Content="Mark Paid" Click="MarkAsPaid_Click"
                                                    Background="#7E57C2" Foreground="White" FontSize="10" FontWeight="Bold" 
                                                    Padding="8,2" Cursor="Hand" Visibility="Visible">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <!-- Hide button if already paid -->
                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                    <Setter TargetName="btnMarkPaid" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- If overdue but unpaid, we still show it but maybe change color to emphasize urgency -->
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter TargetName="btnMarkPaid" Property="Background" Value="#FF8C00"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Bottom Summary Section -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,20,0,0" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1">
                <UniformGrid Columns="3">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Total Amount Paid" Foreground="Gray" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox x:Name="txtTotalPaid" Height="30" IsReadOnly="True" Background="#E8F5E9" Foreground="LimeGreen" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Total Amount Overdue" Foreground="Gray" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox x:Name="txtTotalOverdue" Height="30" IsReadOnly="True" Background="#FFEBEE" Foreground="Red" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Total Remaining" Foreground="Gray" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox x:Name="txtTotalRemaining" Height="30" IsReadOnly="True" Background="#FFF3E0" Foreground="OrangeRed" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</Page>