<Page x:Class="WorkeaseAdmin_WPF.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Health Record">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Status" Background="{StaticResource SidebarSelection}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Nutrition Plan" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F3E5F5" BorderBrush="#FF5CA8" BorderThickness="1">
                <Grid>
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryPink}" Height="60">
                            <TextBlock Text="Child Health &amp; Nutrition" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <DataGrid AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Child Name" Width="*"/>
                                <DataGridTextColumn Header="Weight (kg)" Width="100"/>
                                <DataGridTextColumn Header="Height (cm)" Width="100"/>
                                <DataGridTextColumn Header="BMI Status" Width="150"/>
                                <DataGridTextColumn Header="Remarks" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <TextBlock Text="/* Monitor nutrition and health growth here */" Foreground="#85E15F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Update Record" Width="150" Height="45" Background="{StaticResource CardBlue}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>