<Page x:Class="WorkeaseAdmin_WPF.Pages.AddHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Health Record">

    <Page.Resources>
        <!-- Standardized Input Style -->
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Click="ManageHealth_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Click="EditHealth_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteHealth_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Search Bar Section (Primary Blue) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#38b6ff" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Enter Child ID to Record Health" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchChildID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search Child" Click="SearchChild_Click" Width="150" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- 2. Main Form Container -->
            <Border Grid.Row="1" Background="#EBE3F1" CornerRadius="10" Margin="0,0,0,49">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#38b6ff" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="NEW HEALTH RECORD REGISTRATION" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30">

                            <!-- Child Name Row (Added above Height and Weight) -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Child Full Name" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                <TextBox x:Name="txtChildName" Style="{StaticResource InputControlStyle}" 
                                         IsReadOnly="True" Background="#F0F0F0" Foreground="#555"/>
                            </StackPanel>

                            <!-- Weight and Height Row -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Weight (kg)" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBox x:Name="txtWeight" Style="{StaticResource InputControlStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (cm)" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBox x:Name="txtHeight" Style="{StaticResource InputControlStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Notes Section -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Health Notes / Remarks" FontWeight="Bold" Margin="0,0,0,5" FontSize="14"/>
                                <TextBox x:Name="txtNotes" Style="{StaticResource InputControlStyle}" Height="80" 
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"/>
                            </StackPanel>

                            <!-- Instructions Note -->
                            <Border Background="#D1C4E9" Padding="20" CornerRadius="5">
                                <TextBlock Text="ℹ️ Note: Record actual growth data. Once the 'Create' button is clicked, the system will automatically log the record with the current date and time." 
                                           Foreground="#4527A0" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom Create Button -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="Create Health Record" Click="btnCreateRecord_Click" Width="200" Height="45"
                        Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>