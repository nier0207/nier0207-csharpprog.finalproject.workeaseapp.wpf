<Page x:Class="WorkeaseAdmin_WPF.Pages.EditWorkerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Worker">

    <Page.Resources>
        <!-- Specialized Style to match the Pink Theme for ComboBoxes -->
        <Style x:Key="PinkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Workers" Click="ManageWorkers_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Worker" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Worker" Click="AddWorker_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Worker" Click="DeleteWorker_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <!-- Search Bar Section -->
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#FF69B4" BorderThickness="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Enter Worker ID to Edit" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchWorkerID" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search Worker" Click="SearchWorker_Click" Width="150" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Edit Form Section -->
            <Border Background="#EBE3F1" CornerRadius="10" Margin="0,115,0,49">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT WORKER DETAILS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,20">

                            <!-- Full Name -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Full Name" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtFullName" Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>

                            <!-- Email and Password Row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email Address" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtEmail" Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="txtPassword" Height="40" Background="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Role and Center Name Row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Worker Type" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbRole" Style="{StaticResource PinkComboBox}">
                                        <ComboBoxItem Content="CDW"/>
                                        <ComboBoxItem Content="Admin"/>
                                        <ComboBoxItem Content="Parent"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Assigned Center" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbCenter" Style="{StaticResource PinkComboBox}" 
                                              DisplayMemberPath="CenterName" 
                                              SelectedValuePath="CenterId"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="/* Review all fields including Role and Center assignment before saving." 
                                       Foreground="#85E15F" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="13"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom Save Button -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-15">
                <Button Content="Save Changes" Click="SaveChanges_Click" Width="160" Height="45"
                        Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>