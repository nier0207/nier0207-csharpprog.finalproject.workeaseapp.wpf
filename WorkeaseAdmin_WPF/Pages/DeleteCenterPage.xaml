<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Center">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Center" Click="EditCenter_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Center" Click="AddCenter_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Center" Background="#B00020" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Enter Center ID" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <TextBox Width="150" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>
                    <Button Content="Search Center" 
                            Width="130" 
                            Height="35" 
                            Margin="0,14,0,0" 
                            Background="#B00020" 
                            Foreground="White" 
                            FontWeight="SemiBold"
                            BorderThickness="0" 
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="15" BorderBrush="#B00020" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <Border Background="#B00020" Height="55" CornerRadius="14,14,0,0">
                        <TextBlock Text="CONFIRM DELETION" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,25">
                        <TextBlock Text="Name of Center" FontWeight="Bold" Foreground="#B00020" Margin="0,0,0,5"/>
                        <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,20" Background="#F9F9F9" IsReadOnly="True" BorderBrush="#E0E0E0"/>

                        <TextBlock Text="Location" FontWeight="Bold" Foreground="#B00020" Margin="0,0,0,5"/>
                        <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,30" Background="#F9F9F9" IsReadOnly="True" BorderBrush="#E0E0E0"/>

                        <Button Content="DELETE CENTER" 
                                Width="180" 
                                Height="45" 
                                Background="#B00020" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                BorderThickness="0" 
                                HorizontalAlignment="Right"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>