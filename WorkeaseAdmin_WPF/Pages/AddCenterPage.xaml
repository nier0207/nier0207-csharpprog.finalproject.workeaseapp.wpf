<Page x:Class="WorkeaseAdmin_WPF.Pages.AddCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Center">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Click="ManageCenters_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Center" Click="EditCenter_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Center" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Border Background="White" CornerRadius="15" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PrimaryPink}" CornerRadius="14,14,0,0">
                        <TextBlock Text="ADD NEW CENTER" 
                                   Foreground="White" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="40,30">
                        <TextBlock Text="Center Name" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                        <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,20"/>

                        <TextBlock Text="Barangay / Location" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                        <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,20"/>

                        <TextBlock Text="Assigned Worker" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Margin="0,0,0,5"/>
                        <ComboBox Height="40" VerticalContentAlignment="Center" Margin="0,0,0,30"/>

                        <Button Content="Register Center" Width="200" Height="50" HorizontalAlignment="Right" 
                                Background="{StaticResource CardBlue}" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>