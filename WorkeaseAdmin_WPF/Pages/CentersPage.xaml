<Page x:Class="WorkeaseAdmin_WPF.Pages.CentersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Centers">
    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Manage Centers" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0"/>
            <Button Content="Edit Center" Click="EditCenter_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Add Center" Click="AddCenter_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
            <Button Content="Delete Center" Click="DeleteCenter_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Border Background="#F3E5F5" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryPink}" Height="60">
                        <TextBlock Text="MANAGE CENTERS" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="CentersGrid" AutoGenerateColumns="True" Background="Transparent" BorderThickness="0" Margin="10"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>