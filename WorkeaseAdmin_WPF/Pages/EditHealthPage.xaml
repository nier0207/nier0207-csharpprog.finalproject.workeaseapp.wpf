<Page x:Class="WorkeaseAdmin_WPF.Pages.EditHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Health Record">

    <Page.Resources>
        <Style x:Key="PinkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Click="ManageHealt_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Click="DeleteHealth_Click" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <!-- Increased height for better visibility -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Search Bar Section -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" BorderBrush="{StaticResource PrimaryPink}" BorderThickness="2" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Child ID/Name" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchHealthBox" Width="200" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <TextBlock Text="Filter by Center Name" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCenterSearch" Width="200" Height="35" VerticalContentAlignment="Center" BorderBrush="#DDD" 
                                  DisplayMemberPath="CenterName" SelectedValuePath="CenterId"/>
                    </StackPanel>

                    <Button Content="Search" Click="Search_Click" Width="100" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" 
                            Background="#38b6ff" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- 2. Health List View (Recoded for DTO Properties) -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,15">
                <ListView x:Name="HealthListView" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          Margin="5"
                          SelectionMode="Single"
                          SelectionChanged="HealthListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding HealthRecordId}" Width="40"/>
                            <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding ChildName}" Width="140"/>
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding HealthRecordCreatedAt, StringFormat=\{0:MM/dd/yyyy\}}" Width="90"/>
                            <GridViewColumn Header="Weight" DisplayMemberBinding="{Binding HealthWeightKg, StringFormat=\{0:F2\}}" Width="65"/>
                            <GridViewColumn Header="Height" DisplayMemberBinding="{Binding HealthHeightCm, StringFormat=\{0:F1\}}" Width="65"/>
                            <GridViewColumn Header="BMI Status" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtBmiStatus" Text="{Binding BmiStatus}" FontWeight="Bold"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding BmiStatus}" Value="Normal">
                                                <Setter TargetName="txtBmiStatus" Property="Foreground" Value="LimeGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BmiStatus}" Value="Underweight">
                                                <Setter TargetName="txtBmiStatus" Property="Foreground" Value="OrangeRed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BmiStatus}" Value="Overweight">
                                                <Setter TargetName="txtBmiStatus" Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Notes" DisplayMemberBinding="{Binding HealthNotes, TargetNullValue='---'}" Width="120"/>
                            <GridViewColumn Header="Last Edit" DisplayMemberBinding="{Binding HealthRecordUpdatedAt, StringFormat=\{0:MM/dd/yyyy HH:mm\}}" Width="130"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 3. Edit Form Section -->
            <Border Grid.Row="2" Background="#EBE3F1" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF69B4" Height="40" CornerRadius="10,10,0,0">
                        <TextBlock Text="EDIT HEALTH RECORD DETAILS" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="25,15">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Record Date" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <DatePicker x:Name="dtHealthDate" Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Selected Child" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBox x:Name="txtChildName" IsReadOnly="True" Background="#F0F0F0" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Weight (kg)" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBox x:Name="txtWeight" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="White" BorderThickness="1" BorderBrush="#DDD"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (cm)" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBox x:Name="txtHeight" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="White" BorderThickness="1" BorderBrush="#DDD"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Health Notes / Remarks" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Background="White" BorderThickness="1" BorderBrush="#DDD"/>

                            <Button Content="SAVE CHANGES" Click="SaveChanges_Click" Width="160" Height="40" Margin="0,15,0,0" 
                                    Background="#FF69B4" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>