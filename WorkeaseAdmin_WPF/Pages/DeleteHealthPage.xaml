<Page x:Class="WorkeaseAdmin_WPF.Pages.DeleteHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Delete Health Record">

    <Grid Background="#F5F0FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource DeepPurple}">
            <Button Content="Health Records" Click="BackToHealth_Click" Background="{StaticResource DeepPurple}" Foreground="White" Height="50" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Edit Record" Click="EditHealth_Click" Background="#7E57C2" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Add Record" Click="AddHealth_Click" Background="#38b6ff" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
            <Button Content="Delete Record" Background="#e12749" Foreground="White" Height="50" BorderThickness="0" Margin="0,2,0,0" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Section (Kopyang-kopya sa Edit Center style) -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Top" Height="100" BorderBrush="#e12749" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Search Health ID or Name to Delete" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchDeleteBox" Width="250" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#DDD"/>
                    </StackPanel>

                    <Button Content="Search" Width="120" Height="35" Margin="20,0,0,0" VerticalAlignment="Bottom" Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Record Details Panel (Display only) -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" VerticalAlignment="Top" BorderBrush="#e12749" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#e12749" Height="60" CornerRadius="10,10,0,0">
                        <TextBlock Text="CONFIRM RECORD FOR DELETION" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,20">
                        <TextBlock Text="Child Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#e12749"/>
                        <TextBox x:Name="txtChildName" Height="35" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,-5"/>

                        <Grid Margin="0,20,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight (kg)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <TextBox x:Name="WeightBox" Height="35" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (cm)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#444"/>
                                <TextBox x:Name="HeightBox" Height="35" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nutritional Status" FontWeight="Bold" Margin="0,10,0,5" Foreground="#444"/>
                        <TextBox x:Name="StatusBox" Height="35" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#DDD" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Remarks" FontWeight="Bold" Margin="0,15,0,5" Foreground="#444"/>
                        <TextBox x:Name="RemarksBox" Height="50" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#DDD" TextWrapping="Wrap" Padding="10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Discard" Click="BackToHealth_Click" Width="120" Height="40" Background="Transparent" Foreground="Gray" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="DELETE RECORD" Click="ConfirmDelete_Click" Width="180" Height="40" Background="#e12749" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>